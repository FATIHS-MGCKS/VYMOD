    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "intl-messageformat": "^10.7.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "^7.1.11",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
