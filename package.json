{
  "name": "vymod",
  "version": "0.1.0",
  "private": true,
  "description": "VYMOD — consumer vehicle intelligence (governance + mobile P1)",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "validate": "node tools/governance/run-all.mjs",
    "validate:i18n": "node tools/governance/run-all.mjs --only i18n",
    "validate:docs": "node tools/governance/run-all.mjs --only docs",
    "test": "node --test tools/governance/tests/*.test.mjs",
    "test:mobile": "npm run test --workspace @vymod/mobile",
    "test:all": "npm test && npm run test:mobile",
    "typecheck": "npm run typecheck --workspace @vymod/mobile",
    "lint": "npm run lint --workspace @vymod/mobile",
    "mobile:start": "npm run start --workspace @vymod/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@formatjs/icu-messageformat-parser": "^2.9.8",
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  }
}
